{
  "name": "pi-context-decisions",
  "version": "5.2.0",
  "description": "Pi extension that uses decision/classifier models (Pi, TypeSafe JEV, OpenAI, OpenRouter) to filter which skills are advertised and, opt-in, which external tools and MCP servers are available for each prompt",
  "type": "module",
  "license": "MIT",
  "author": "Arnav Gupta",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "skills",
    "decisions",
    "classifiers",
    "context"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/championswimmer/pi-context-decisions.git"
  },
  "homepage": "https://github.com/championswimmer/pi-context-decisions#readme",
  "bugs": {
    "url": "https://github.com/championswimmer/pi-context-decisions/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "files": [
    "dist/",
    "docs/*.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./extension": {
      "types": "./dist/extension.d.ts",
      "import": "./dist/extension.js"
    },
    "./pi-credentials": {
      "types": "./dist/host/pi-credentials.d.ts",
      "import": "./dist/host/pi-credentials.js"
    },
    "./package.json": "./package.json"
  },
  "pi": {
    "extensions": [
      "./dist/extension.js"
    ]
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "demo:skills": "node --experimental-strip-types scripts/demo-skill-picker.ts",
    "changelog": "node --experimental-strip-types .github/scripts/changelog.ts",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "pi-extension-settings-tui": "^0.5.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": ">=1.5.0",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.5.2",
    "@earendil-works/pi-coding-agent": "^1.5.2",
    "@earendil-works/pi-tui": "^1.5.2",
    "@types/node": "^22.15.0",
    "@xterm/headless": "5.5.0",
    "typescript": "^5.9.3"
  }
}
