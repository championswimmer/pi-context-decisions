{
  "name": "pi-context-decisions",
  "version": "1.0.1",
  "description": "Pi extension that uses decision/classifier models (Pi, TypeSafe JEV, OpenAI, OpenRouter) to filter which skills are advertised and, opt-in, which external tools and MCP servers are available for each prompt",
  "type": "module",
  "license": "MIT",
  "author": "Arnav Gupta",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "skills",
    "decisions",
    "classifiers",
    "context"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/championswimmer/pi-context-decisions.git"
  },
  "homepage": "https://github.com/championswimmer/pi-context-decisions#readme",
  "bugs": {
    "url": "https://github.com/championswimmer/pi-context-decisions/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "files": [
    "src/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./extension": "./src/extension.ts",
    "./pi-credentials": "./src/host/pi-credentials.ts"
  },
  "types": "./src/index.ts",
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "demo:skills": "node --experimental-strip-types scripts/demo-skill-picker.ts",
    "changelog": "node --experimental-strip-types .github/scripts/changelog.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0",
    "@types/node": "^22.15.0",
    "@xterm/headless": "5.5.0",
    "typescript": "^5.9.3"
  }
}
